{
  "name": "bugrep-ai",
  "version": "4.0.0",
  "description": "BugRep-AI: from bug report to verified repair. IBM Bob agents reproduce, repair and verify bugs with human approval, plus Jira/Slack/Teams sharing.",
  "main": "web/server.js",
  "bin": {
    "bugrep": "./cli.js"
  },
  "scripts": {
    "start": "node web/server.js",
    "web": "node web/server.js",
    "bugrep": "node cli.js",
    "preflight": "node cli.js preflight",
    "demo": "node cli.js run --demo",
    "test": "jest --runInBand"
  },
  "engines": {
    "node": ">=18"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ]
  },
  "dependencies": {
    "@ibm-cloud/watsonx-ai": "^1.7.16",
    "@vercel/functions": "^3.9.9",
    "adm-zip": "^0.5.16",
    "diff": "^7.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "ibm-cloud-sdk-core": "^5.0.0",
    "jest": "^29.7.0"
  }
}
