{
  "name": "bugrep-ai",
  "version": "3.0.0",
  "description": "AI agents that find, reproduce, fix and report bugs from a plain-English bug report — powered by IBM Bob",
  "main": "web/server.js",
  "bin": {
    "bugrep": "./cli.js"
  },
  "scripts": {
    "start": "node web/server.js",
    "web": "node web/server.js",
    "bugrep": "node cli.js",
    "demo": "node cli.js run --demo --yes",
    "test": "jest"
  },
  "engines": {
    "node": ">=18"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ]
  },
  "dependencies": {
    "@ibm-cloud/watsonx-ai": "^1.7.16",
    "adm-zip": "^0.5.16",
    "diff": "^7.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "ibm-cloud-sdk-core": "^5.0.0",
    "jest": "^29.7.0"
  }
}
