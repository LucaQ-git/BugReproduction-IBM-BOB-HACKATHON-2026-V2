# BugRep AI — environment variables
# Copy this file to .env (same folder) and fill in ONE AI engine.
# NEVER commit .env: it is git-ignored.

# ── IBM Bob Shell (preferred) ────────────────────────────────────────────────
# Generate a key at https://bob.ibm.com → Settings → API Keys
BOBSHELL_API_KEY=
# Only if `bob` is not on your PATH (Windows example):
# BOB_CLI_PATH=C:\Users\you\AppData\Roaming\npm\bob.cmd
# Extra flags for `bob run`. Only add --accept-license after reading and accepting Bob's license.
# BOB_EXTRA_ARGS=
# BOB_TIMEOUT_MS=300000

# ── IBM watsonx.ai (alternative) ─────────────────────────────────────────────
# WATSONX_API_KEY=
# WATSONX_PROJECT_ID=
# WATSONX_SERVICE_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# ── GitHub (optional, for private repos / higher rate limits) ───────────────
# GITHUB_TOKEN=

# ── Server ──────────────────────────────────────────────────────────────────
# PORT=3000
# HOST=127.0.0.1
# PYTHON=python3
