# BugRep-AI — environment variables (copy to .env in this folder).
# PLACEHOLDERS ONLY. Never commit .env. No value here is ever sent to the browser or written to reports.

# ── IBM Bob (default, operational agent) ─────────────────────────────────────
BOBSHELL_API_KEY=<your-bob-api-key>
# BOB_CLI_PATH=<full path to bob or bob.cmd if it is not on PATH>
# BOB_EXTRA_ARGS=<extra flags for `bob run`, e.g. --accept-license only after accepting Bob's license>
# BOB_MODE=agent
# BOB_INPUT=auto            # auto | inline | file

# ── Timeouts (milliseconds) — every external process has one ───────────────
# BOB_CALL_TIMEOUT_MS=180000     # one Investigator or Repairer call
# TEST_TIMEOUT_MS=120000         # one Jest / pytest run
# PIPELINE_TIMEOUT_MS=600000     # whole run (time waiting for approval is not counted)
# INSTALL_TIMEOUT_MS=300000      # npm install for uploaded projects
# FETCH_TIMEOUT_MS=60000         # GitHub download
# INTEGRATION_TIMEOUT_MS=15000   # Jira / Slack / Teams request

# ── IBM watsonx.ai (EXPERIMENTAL provider) ──────────────────────────────────
# WATSONX_API_KEY=<ibm-cloud-api-key>
# WATSONX_PROJECT_ID=<watsonx-project-id>
# WATSONX_SERVICE_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# ── Jira (optional) ─────────────────────────────────────────────────────────
# JIRA_BASE_URL=https://<your-site>.atlassian.net
# JIRA_EMAIL=<jira-account-email>
# JIRA_API_TOKEN=<jira-api-token>
# JIRA_PROJECT_KEY=<PROJECT-KEY>
# JIRA_ISSUE_TYPE=Bug

# ── Slack (optional) ────────────────────────────────────────────────────────
# SLACK_WEBHOOK_URL=<slack-incoming-webhook-url>

# ── Microsoft Teams (optional) ──────────────────────────────────────────────
# TEAMS_WEBHOOK_URL=<teams-workflow-or-webhook-url>

# ── GitHub (optional, private repos / rate limits) ──────────────────────────
# GITHUB_TOKEN=<github-token>

# ── Server ──────────────────────────────────────────────────────────────────
# PORT=3000
# HOST=127.0.0.1
# PUBLIC_BASE_URL=http://localhost:3000   # used for "Open run" links in Slack/Teams/Jira
# PYTHON=python3
