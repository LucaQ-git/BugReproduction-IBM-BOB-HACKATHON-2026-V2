{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix bugrep-ai",
  "outputDirectory": "bugrep-ai/web/public",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "bugrep-ai/{web/public,demo,node_modules}/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
